{
  "scope": "Availability-selected Toronto-area 1901 census demonstration; no population accuracy claim and no guarantee of absence from pretrained model training data.",
  "selection": "Development uses enumerator Cornelius W Bastido. Test pages use distinct enumerators and retain every York-labeled person on each selected page. Publicly downloadable matched pages are chosen before test inference, without inspecting model results.",
  "input": "Manual page, column and row localization. The script rectifies the scan, assembles name, age, occupation and earnings cells into ten-row panels, and adds modern column headings and physical line numbers. All fifty source rows are transcribed, including those not labeled by York. This evaluates assisted transcription, not automatic full-page layout recovery.",
  "models": {
    "chandra": "Native chandra-ocr OCR_PROMPT, HTML table, MLX BF16",
    "qwen27b": "Qwen3.8 27B MXFP8 via Ollama MLX; JSON prompt, thinking disabled",
    "qwen2b": "Qwen3.5 2B GGUF Q8_0 via Ollama; JSON prompt, thinking disabled"
  },
  "settings": {
    "temperature": 0,
    "max_tokens": 4096,
    "panel_size": [
      1410,
      1070
    ],
    "qwen_context": 16384
  },
  "alignment": "Align each uniquely identified printed line independently; duplicate or absent line IDs are unavailable. Map HTML fields by unique headers and column spans; a split or ambiguous column becomes NaN without discarding other columns. Keep complete JSON objects from a truncated response; missing fields are NaN. No reference-assisted alignment or repairs.",
  "scoring": "Age and earnings digit accuracy: one minus summed Levenshtein character edits divided by reference digits, evaluated within available filled cells after numeric normalization. Extra or unrecognized characters count as edits. Extracted blanks incur deletion errors; unavailable NaN output is excluded from conditional accuracy and counted in coverage. Whole-value and blank agreement use available-cell denominators. Names and occupations remain unscored raw output.",
  "normalization": "Unicode NFKC and casefolding; blank or * or dash treated as missing; currency symbols and commas removed; earnings rounded to nearest dollar; infant age fractions converted to completed years. No reference-assisted correction.",
  "uncertainty": "References containing ! ? { } = are excluded from known-cell agreement and counted separately. Manually flagged age labels remain unchanged and included.",
  "distribution": "Download full source scans and York reference labels from their original hosts into ignored build/; no source corpus mirror. This repository contains geometry, model outputs, aggregate comparisons, and one attributed ten-row teaching illustration. No open-data licence is asserted for York labels.",
